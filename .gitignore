# Gradle
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Spring Boot (빌드 산출물만 제외 — wrapper jar는 아래에서 예외 처리)
*.jar
*.war
*.ear
target/

# gradle wrapper jar는 반드시 커밋 (*.jar 규칙 이후에 선언해야 우선 적용)
!gradle/wrapper/gradle-wrapper.jar

# 환경변수 / 시크릿
.env
.env.*
application-local.yml
application-prod.yml
application-secret.yml

# 로그
*.log
logs/

# Python (embed_server)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
embed_server/venv/
embed_server/.venv/
embed_server/*.egg-info/

# Node (frontend)
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/.env.local

# H2 DB 파일
*.db
*.mv.db
*.trace.db
.claude/settings.local.json
